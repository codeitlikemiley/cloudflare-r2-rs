# Copy to .env and fill in. Used by the examples and the live tests.

# Your Cloudflare account ID; the R2 endpoint is derived from it.
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# Alternatively, set the endpoint directly instead of R2_ACCOUNT_ID.
# Useful for jurisdiction endpoints or an S3-compatible server run locally.
# R2_ENDPOINT=https://0123456789abcdef.r2.cloudflarestorage.com

# R2 API token credentials (R2 > Manage API tokens in the Cloudflare dashboard).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket the client is bound to.
R2_BUCKET=my-bucket

# Optional: default | eu | fedramp
# R2_JURISDICTION=default

# Optional: signing region, defaults to "auto".
# R2_REGION=auto
